/* 云游山河小程序壳 —— 未配置 H5 时的引导页
   与 H5 端品牌一致：暖宣纸底 + 墨色文字 + 朱砂印章 + 描金分隔线 */

page {
  min-height: 100%;
  background-color: #f6f1e7;
}

.setup-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
  min-height: 100vh;
  text-align: center;
}

/* 朱砂印章（与 H5 主页「游/康」印同款） */
.tip-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin-bottom: 28rpx;
  border-radius: 22rpx;
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 88rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(150deg, #c94b3c, #8e2f26);
  box-shadow: 0 10rpx 30rpx rgba(142, 47, 38, 0.4),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.3);
  transform: rotate(-6deg);
}

.tip-title {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: #2b3a4a;
  margin-bottom: 20rpx;
}

/* 描金分隔线（金线 + 菱形金点，呼应 H5 主页云纹分隔） */
.tip-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 420rpx;
  margin-bottom: 32rpx;
}
.tip-divider .line {
  flex: 1;
  height: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 151, 30, 0.75));
}
.tip-divider .line:last-child {
  background: linear-gradient(90deg, rgba(201, 151, 30, 0.75), transparent);
}
.tip-divider .diamond {
  width: 14rpx;
  height: 14rpx;
  background: linear-gradient(135deg, #e0b33c, #c9971e);
  transform: rotate(45deg);
}

.tip-body {
  font-size: 30rpx;
  color: #5a6b7d;
  margin-bottom: 24rpx;
}

/* 接入步骤卡片（宣纸卡片质感） */
.tip-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx 36rpx;
  border-radius: 24rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(201, 151, 30, 0.35);
  box-shadow: 0 6rpx 24rpx rgba(43, 58, 74, 0.1);
  margin-bottom: 28rpx;
}
.tip-steps .step {
  font-size: 28rpx;
  color: #2b3a4a;
  line-height: 1.7;
  text-align: left;
}

.tip-more {
  font-size: 26rpx;
  color: #8a97a5;
}
