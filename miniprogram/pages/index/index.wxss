.setup-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  min-height: 80vh;
  text-align: center;
}
.tip-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.tip-title { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.tip-body { font-size: 28rpx; color: #5a6b7d; line-height: 1.7; }
